# Copy this to .env.local for local development
# Set these as Environment Variables in your Vercel dashboard for production

# Baserow Configuration
BASEROW_TOKEN=your_baserow_api_token_here
BASEROW_DB_ID=your_baserow_database_id_here
TASKS_TABLE_ID=your_tasks_table_id_here
METRICS_TABLE_ID=your_metrics_table_id_here
VENDORS_TABLE_ID=your_vendors_table_id_here

# Frontend Configuration
REACT_APP_API_URL=https://your-project-name.vercel.app
